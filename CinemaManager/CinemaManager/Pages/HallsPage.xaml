<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CinemaManager.Pages"
             xmlns:dto="clr-namespace:CinemaManager.DTOs.Halls;assembly=CinemaManager.DTOs"
             xmlns:vm="clr-namespace:CinemaManager.ViewModels"
             x:Class="CinemaManager.Pages.HallsPage"
             x:DataType="vm:HallsViewModel"
             Title="Halls Page">

    <Grid Padding="15">
        <CollectionView ItemsSource="{Binding Halls}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dto:HallListDTO">
                    <Border Margin="0,5" Padding="10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HallsViewModel}}, Path=LoadHallDetailsCommand}" 
                                CommandParameter="{Binding Id}"/>
                        </Border.GestureRecognizers>
                        <VerticalStackLayout>
                            <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label Text="{Binding NumberOfSessions, StringFormat='Sessions: {0}'}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dto="clr-namespace:CinemaManager.DTOs.Sessions;assembly=CinemaManager.DTOs"
             xmlns:local="clr-namespace:CinemaManager.Pages"
             xmlns:vm="clr-namespace:CinemaManager.ViewModels"
             x:Class="CinemaManager.Pages.HallDetailsPage"
             x:DataType="vm:HallDetailsViewModel"
             Title="Hall Details">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Label Text="{Binding Hall.Name, FallbackValue='Loading...'}" Style="{StaticResource Headline}" />
            <VerticalStackLayout Spacing="10">
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label Text="Hall Type:" FontAttributes="Bold" />
                    <Label Text="{Binding Hall.CinemaHallType,
                                          Converter={StaticResource EnumDisplayConverter},
                                          FallbackValue='N/A'}" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Label Text="Number of Seats:" />
                    <Label Text="{Binding Hall.NumberOfSeats, FallbackValue='N/A'}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <BoxView HeightRequest="1" Margin="0,10" />
            <Label Text="Sessions Schedule:" />
            <CollectionView ItemsSource="{Binding Sessions}">
                <CollectionView.EmptyView>
                    <Label Text="No sessions scheduled" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:SessionListDTO">
                        <Border Padding="15" Margin="0,5">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HallDetailsViewModel}}, Path=LoadSessionDetailsCommand}" 
                                    CommandParameter="{Binding Id}"/>
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding MovieName, FallbackValue='Unknown Movie'}" HorizontalOptions="Center"/>
                                <Label Text="{Binding StartTime, StringFormat='{0:dd.MM.yyyy HH:mm}', FallbackValue='TBA'}" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
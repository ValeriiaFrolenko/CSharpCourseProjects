<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dto="clr-namespace:CinemaManager.DTOs.Sessions;assembly=CinemaManager.DTOs"
             xmlns:vm="clr-namespace:CinemaManager.ViewModels"
             xmlns:forms="clr-namespace:CinemaManager.ViewModels.Forms"
             x:Class="CinemaManager.Pages.HallDetailsPage"
             x:DataType="vm:HallDetailsViewModel"
             Title="Hall Details">

    <Grid>

        <ScrollView IsEnabled="{Binding IsNotBusy}">
            <VerticalStackLayout Padding="20" Spacing="15">

                <!-- Display Mode -->
                <VerticalStackLayout IsVisible="{Binding IsDisplayMode}" Spacing="12">

                    <Label Text="{Binding Hall.Name, FallbackValue='Loading...'}"
                           Style="{StaticResource Headline}" />

                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Type:" FontAttributes="Bold" />
                            <Label Text="{Binding Hall.CinemaHallType,
                                                   Converter={StaticResource EnumDisplayConverter},
                                                   FallbackValue='N/A'}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Seats:" FontAttributes="Bold" />
                            <Label Text="{Binding Hall.NumberOfSeats, FallbackValue='N/A'}" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="Total duration:" FontAttributes="Bold" />
                            <Label Text="{Binding Hall.TotalDurationDisplay, FallbackValue='N/A'}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <Button Text="Edit Hall"
                            Command="{Binding StartEditCommand}"
                            HorizontalOptions="Start" />

                </VerticalStackLayout>

                <!-- Edit Mode -->
                <Border Padding="15" IsVisible="{Binding IsEditMode}">
                    <VerticalStackLayout Spacing="8"
                                        BindingContext="{Binding EditForm}"
                                        x:DataType="forms:HallFormViewModel">

                        <Label Text="Edit Hall" FontAttributes="Bold" FontSize="16" />

                        <Entry Placeholder="Hall name" Text="{Binding Name}" />
                        <Label Text="{Binding NameError}"
                               TextColor="Red" FontSize="12"
                               IsVisible="{Binding NameError, Converter={StaticResource IsNotNullConverter}}" />

                        <Entry Placeholder="Number of seats" Text="{Binding SeatsText}" Keyboard="Numeric" />
                        <Label Text="{Binding SeatsError}"
                               TextColor="Red" FontSize="12"
                               IsVisible="{Binding SeatsError, Converter={StaticResource IsNotNullConverter}}" />

                        <Picker Title="Hall type"
                                ItemsSource="{Binding HallTypes}"
                                SelectedItem="{Binding HallType}"
                                ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}" />

                        <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                            <Button Text="Save" Command="{Binding SubmitCommand}" />
                            <Button Text="Cancel" Command="{Binding CancelCommand}" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <BoxView HeightRequest="1" Margin="0,5" />

                <!-- Sessions Section -->
                <Label Text="Sessions" FontSize="18" FontAttributes="Bold" />

                <SearchBar Placeholder="Search sessions..."
                           Text="{Binding SearchText}" />

                <!-- Add Session Form -->
                <Border Padding="15" IsVisible="{Binding IsAddingSession}">
                    <VerticalStackLayout Spacing="8"
                                        BindingContext="{Binding AddSessionForm}"
                                        x:DataType="forms:SessionFormViewModel">

                        <Label Text="New Session" FontAttributes="Bold" FontSize="16" />

                        <Entry Placeholder="Movie name" Text="{Binding MovieName}" />
                        <Label Text="{Binding MovieNameError}"
                               TextColor="Red" FontSize="12"
                               IsVisible="{Binding MovieNameError, Converter={StaticResource IsNotNullConverter}}" />

                        <Picker Title="Genre"
                                ItemsSource="{Binding FilmGenres}"
                                SelectedItem="{Binding Genre}"
                                ItemDisplayBinding="{Binding ., Converter={StaticResource EnumDisplayConverter}}" />

                        <Entry Placeholder="Year of release" Text="{Binding YearText}" Keyboard="Numeric" />
                        <Label Text="{Binding YearError}"
                               TextColor="Red" FontSize="12"
                               IsVisible="{Binding YearError, Converter={StaticResource IsNotNullConverter}}" />

                        <DatePicker Date="{Binding Date}" />
                        <TimePicker Time="{Binding Time}" />

                        <Entry Placeholder="Duration (minutes)" Text="{Binding DurationText}" Keyboard="Numeric" />
                        <Label Text="{Binding DurationError}"
                               TextColor="Red" FontSize="12"
                               IsVisible="{Binding DurationError, Converter={StaticResource IsNotNullConverter}}" />

                        <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                            <Button Text="Save" Command="{Binding SubmitCommand}" />
                            <Button Text="Cancel" Command="{Binding CancelCommand}" />
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Sessions List -->
                <CollectionView ItemsSource="{Binding Sessions}">
                    <CollectionView.EmptyView>
                        <Label Text="No sessions found."
                               HorizontalOptions="Center"
                               Margin="0,10" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:SessionListDTO">
                            <Border Padding="12" Margin="0,4">
                                <Grid ColumnDefinitions="*,Auto">

                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HallDetailsViewModel}},
                                                                  Path=LoadSessionDetailsCommand}"
                                                CommandParameter="{Binding Id}" />
                                        </VerticalStackLayout.GestureRecognizers>
                                        <Label Text="{Binding MovieName, FallbackValue='Unknown'}"
                                               FontAttributes="Bold" />
                                        <Label Text="{Binding StartTime,
                                                               StringFormat='{0:dd.MM.yyyy HH:mm}',
                                                               FallbackValue='TBA'}" />
                                    </VerticalStackLayout>

                                    <Button Grid.Column="1"
                                            Text="Delete"
                                            VerticalOptions="Center"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HallDetailsViewModel}},
                                                              Path=DeleteSessionCommand}"
                                            CommandParameter="{Binding Id}" />

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Add Session Button -->
                <Button Text="+ Add Session"
                        Command="{Binding ShowAddSessionFormCommand}"
                        IsVisible="{Binding IsAddingSession, Converter={StaticResource InvertedBoolConverter}}"
                        HorizontalOptions="Fill" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading Overlay -->
        <Grid IsVisible="{Binding IsBusy}"
              BackgroundColor="{AppThemeBinding Light=#80FFFFFF, Dark=#80000000}">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Color="{AppThemeBinding Light=Black, Dark=White}" />
        </Grid>

    </Grid>

</ContentPage>
